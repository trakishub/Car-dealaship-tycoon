		local HumanoidRootPart = p11:FindFirstChild("HumanoidRootPart")

		if HumanoidRootPart then
			for _, child in pairs(HumanoidRootPart:GetChildren()) do
				if (child:IsA("BodyForce") or child:IsA("BodyAngularVelocity")) and child.Name == "FlingForce" then
					child:Destroy()
				end
			end

			local BodyForce = Instance.new("BodyForce")

			BodyForce.Name = "FlingForce"
			BodyForce.Force = Vector3.new(0, 0, 0)
			BodyForce.Parent = HumanoidRootPart

			local BodyAngularVelocity = Instance.new("BodyAngularVelocity")

			BodyAngularVelocity.Name = "FlingForce"
			BodyAngularVelocity.MaxTorque = Vector3.new(100000000, 100000000, 100000000)
			BodyAngularVelocity.AngularVelocity = Vector3.new(50, 50, 50)
			BodyAngularVelocity.Parent = HumanoidRootPart

			return BodyForce, BodyAngularVelocity
		end

		return
	end
